{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["bun-types"],
    "allowImportingTsExtensions": true,
    "preserveSymlinks": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "bun:sqlite": ["src/sync/sqlite.ts"],
      "@protontech/drive-sdk": ["sdk/client/js/src/index.ts"],
      "@protontech/drive-sdk/*": ["sdk/client/js/src/*"],
      "proton-drive-sdk-account": ["sdk/incubating/account/js/src/index.ts"],
      "proton-drive-sdk-account/*": ["sdk/incubating/account/js/src/*"]
    }
  },
  "include": ["src/**/*", "tests/**/*"],
  "exclude": ["node_modules", "sdk/**/*.test.ts"]
}
