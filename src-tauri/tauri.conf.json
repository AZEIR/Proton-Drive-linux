{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Proton Drive Linux",
  "version": "1.0.0",
  "identifier": "com.azeir.protondrivelinux",
  "build": {
    "devUrl": "http://localhost:8085",
    "frontendDist": "http://localhost:8085"
  },
  "app": {
    "windows": [
      {
        "title": "Proton Drive",
        "width": 1050,
        "height": 720,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/proton-sync"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
